# ============================================================
# DDABONG KOREA STUDIO OS — 환경변수 템플릿
# ============================================================
# 이 파일(.env.example)은 "어떤 키가 필요한지" 만 적는 목록이다.
# 실제 값은 절대 여기 적지 않는다. 이 파일은 git 에 올라간다.
#
# 사용법
#   1) 이 파일을 복사해서 .env 를 만든다  (cp .env.example .env)
#   2) .env 에만 진짜 값을 채운다
#   3) .env 는 .gitignore 에 걸려 있어 git 에 안 올라간다
#
# 현재 상태 (2026-09-16)
#   이 프로젝트는 아직 어떤 코드도 환경변수를 읽지 않는다.
#   이미지·영상·음성 생성은 전부 claude.ai 커넥터(로그인 방식)로 하므로
#   API 키가 필요 없다. 아래 항목은 앞으로 필요해질 때를 위한 자리다.
#   값이 비어 있어도 지금 작업에는 아무 문제가 없다.
# ============================================================

# ---------- 1. 유튜브 게시 (P-예정: 채널 핸들·Studio 접근 결정 후) ----------
# 러프컷 완성 후 업로드·메타데이터·썸네일 자동화를 코드로 할 경우에만 필요.
# Google Cloud Console > YouTube Data API v3 에서 발급.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ---------- 2. Higgsfield (직접 API 호출로 바꿀 경우에만) ----------
# 지금은 claude.ai 커넥터로 쓰므로 비워 둔다.
# 커넥터가 아니라 스크립트로 직접 생성을 돌릴 때만 채운다.
HIGGSFIELD_API_KEY=

# ---------- 3. 고증 리서치 보조 (선택) ----------
# 국가유산청·e뮤지엄 등 공공 API 를 코드로 조회할 경우.
# 현재는 WebSearch/WebFetch 로 처리하므로 불필요.
KHERITAGE_API_KEY=
EMUSEUM_API_KEY=

# ---------- 4. 분석 (선택) ----------
# 09_ANALYTICS 자동 수집을 붙일 경우.
YOUTUBE_ANALYTICS_ENABLED=false

# ============================================================
# 보안 규칙
#  - .env 를 캡처해서 대화창·카톡·이슈에 붙이지 않는다. 키가 그대로 노출된다.
#  - 키가 한 번이라도 git 에 올라갔으면 값을 바꾸는 것만으로 부족하다.
#    발급처에서 폐기(revoke)하고 새로 발급받아야 한다.
#  - 키를 새로 추가하면 이 .env.example 에도 "이름만" 같이 추가한다.
# ============================================================
