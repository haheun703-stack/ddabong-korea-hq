{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haheun703-stack.github.io/ddabong-korea-hq/00_SYSTEM/schemas/approval.schema.json",
  "title": "APPROVAL (정본 §11·§13)",
  "description": "사람만 승인. 유료 호출 전 Money Gate 제시 내용을 그대로 남긴다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^APR_[A-Z0-9_]+_\\d{3}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "PAID_GENERATION",
        "HISTORICAL_INTERPRETATION",
        "VERSION_APPROVE",
        "RULE_PROMOTION",
        "PUBLISH",
        "OTHER"
      ]
    },
    "target_id": {
      "type": "string",
      "description": "shot_id / generation_id / standard doc / episode_id"
    },
    "money_gate_presented": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "shot_id": {
          "type": "string"
        },
        "provider_model": {
          "type": "string"
        },
        "expected_attempts": {
          "type": "integer"
        },
        "estimated_cost_range": {
          "type": "string"
        },
        "continuity_risk": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "FIX",
        "REJECT",
        "PENDING"
      ]
    },
    "fix_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CAMERA",
        "ARCHITECTURE",
        "COSTUME",
        "LIGHTING",
        "MOTION",
        "CHARACTER_IDENTITY",
        "HISTORICAL_ISSUE",
        "AI_ARTIFACT",
        "OTHER",
        null
      ]
    },
    "decided_by": {
      "type": "string",
      "description": "사람 이름/역할"
    },
    "decided_at": {
      "type": "string",
      "description": "ISO-8601 datetime",
      "format": "date-time"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "approval_id",
    "kind",
    "target_id",
    "decision",
    "decided_by",
    "decided_at"
  ]
}
