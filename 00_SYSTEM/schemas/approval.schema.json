{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haheun703-stack.github.io/ddabong-korea-hq/00_SYSTEM/schemas/approval.schema.json",
  "title": "APPROVAL (정본 §11·§13)",
  "description": "사람만 승인. 유료 호출 전 Money Gate 제시 내용을 그대로 남긴다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^APR_[A-Z0-9_]+_\\d{3}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "PAID_GENERATION",
        "HISTORICAL_INTERPRETATION",
        "VERSION_APPROVE",
        "RULE_PROMOTION",
        "PUBLISH",
        "OTHER"
      ]
    },
    "target_id": {
      "type": "string",
      "description": "shot_id / generation_id / standard doc / episode_id"
    },
    "money_gate_presented": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "shot_id": {
          "type": "string"
        },
        "provider_model": {
          "type": "string"
        },
        "expected_attempts": {
          "type": "integer"
        },
        "estimated_cost_range": {
          "type": "string"
        },
        "continuity_risk": {
          "type": "string"
        },
        "prompt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "승인 범위의 prompt_id (조상 버전 허용). D-035 #5 필수"
        }
      },
      "required": [
        "shot_id",
        "provider_model",
        "expected_attempts",
        "prompt_ids"
      ],
      "description": "PAID_GENERATION 은 null 불가 (검증기). expected_attempts = 최대 호출 수, prompt_ids = 전송 허용 프롬프트 (D-035 #5)"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "FIX",
        "REJECT",
        "PENDING"
      ]
    },
    "fix_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CAMERA",
        "ARCHITECTURE",
        "COSTUME",
        "LIGHTING",
        "MOTION",
        "CHARACTER_IDENTITY",
        "HISTORICAL_ISSUE",
        "AI_ARTIFACT",
        "OTHER",
        null
      ]
    },
    "decided_by": {
      "type": "string",
      "description": "사람 이름/역할"
    },
    "decided_at": {
      "type": "string",
      "description": "ISO-8601 datetime",
      "format": "date-time"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "delegated": {
      "type": "boolean",
      "description": "D-030 사진 전용 위임 승인 (봇이 스스로 승인). true 면 decided_by 에 '봇' 포함, 샷당 ≤ 2 호출 / 4 credits, 위임 누적 ≤ 20 credits (검증기). D-035 #6"
    }
  },
  "required": [
    "approval_id",
    "kind",
    "target_id",
    "decision",
    "decided_by",
    "decided_at"
  ]
}
