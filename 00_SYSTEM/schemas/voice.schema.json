{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haheun703-stack.github.io/ddabong-korea-hq/00_SYSTEM/schemas/voice.schema.json",
  "title": "VOICE (정본 §16)",
  "description": "고정 내레이터 보이스. 얼굴 노출 0% 기본.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "voice_id": {
      "type": "string",
      "pattern": "^VOICE_[A-Z0-9_]+_V\\d{2}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "NARRATOR",
        "CHARACTER",
        "OTHER"
      ]
    },
    "provider": {
      "type": "string"
    },
    "provider_voice_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string"
    },
    "style_notes": {
      "type": "string"
    },
    "sample_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "description": "YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "voice_id",
    "role",
    "provider",
    "language",
    "style_notes",
    "status",
    "updated_at"
  ]
}
