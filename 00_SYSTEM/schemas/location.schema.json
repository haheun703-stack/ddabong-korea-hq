{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haheun703-stack.github.io/ddabong-korea-hq/00_SYSTEM/schemas/location.schema.json",
  "title": "LOCATION (정본 §5·§6)",
  "description": "장소 LOCK. 현재 장소는 REAL_SHOOT, 과거 복원은 Blender 공간 데이터로 고정.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "location_id": {
      "type": "string",
      "description": "예: LOC_GYEONGJU_BURIAL_SITE_V01",
      "pattern": "^LOC_[A-Z0-9_]+_V\\d{2}$"
    },
    "name_ko": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "era": {
      "type": "string"
    },
    "present_day_site": {
      "type": [
        "string",
        "null"
      ]
    },
    "historical_basis": {
      "type": "string",
      "enum": [
        "FACT",
        "PROBABLE",
        "INTERPRETIVE",
        "ARTISTIC"
      ]
    },
    "fact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spatial_lock": {
      "type": "object",
      "description": "Blender 공간 데이터 (구조물 관계, 스케일, 높이)",
      "additionalProperties": true
    },
    "blender_scene_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "MISSING",
              "DRAFT",
              "APPROVED"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "RETIRED"
      ]
    },
    "version": {
      "type": "string",
      "description": "버전 태그 (V01, V02 …)",
      "pattern": "^V\\d{2,}$"
    },
    "updated_at": {
      "type": "string",
      "description": "YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "location_id",
    "name_ko",
    "name_en",
    "era",
    "historical_basis",
    "status",
    "version",
    "updated_at"
  ]
}
