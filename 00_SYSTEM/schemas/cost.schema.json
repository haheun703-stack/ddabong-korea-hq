{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haheun703-stack.github.io/ddabong-korea-hq/00_SYSTEM/schemas/cost.schema.json",
  "title": "COST / MONEY GATE 상태 (정본 §11)",
  "description": "에피소드 예산 대비 소진. 80% 경고 / 95% 강경고 / 100% 잠금.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cost_id": {
      "type": "string",
      "pattern": "^COST_EP\\d{2,3}_\\d{8}$"
    },
    "episode_id": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "KRW",
            "USD",
            "CREDITS"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "description": "미확인이면 null. 0은 실제 0원일 때만."
        },
        "spent": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "currency",
        "amount"
      ]
    },
    "spent_total": {
      "type": [
        "number",
        "null"
      ]
    },
    "spent_by_provider": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "percent_used": {
      "type": [
        "number",
        "null"
      ]
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "OPEN",
        "WARNING_80",
        "STRONG_WARNING_95",
        "LOCKED_100",
        "UNKNOWN_BUDGET"
      ]
    },
    "generation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "as_of": {
      "type": "string",
      "description": "YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "cost_id",
    "episode_id",
    "budget",
    "gate_state",
    "as_of"
  ]
}
